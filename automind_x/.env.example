# AutoMind-X configuration template.
# Copy to `.env` (git-ignored) and export the variables you want, e.g.:
#   set -a; source .env; set +a; python main.py --quick
# AutoMind-X needs NO API keys or credentials - these are tuning knobs only.
# Precedence: CLI flag > environment variable > built-in default.

# Reproducibility: random seed for data, search and baselines (integer)
AUTOMIND_SEED=42

# Search size (integers >= 1, population >= 2)
AUTOMIND_POP_SIZE=14
AUTOMIND_GENERATIONS=12

# Parallel training workers: -1 = all cores, 1 = serial
AUTOMIND_N_JOBS=-1

# Runtime objective: proxy (deterministic FLOPs estimate) | wallclock (measured seconds)
AUTOMIND_RUNTIME_METRIC=proxy

# Final model choice: balanced (weighted fitness) | knee (weight-free best compromise)
AUTOMIND_SELECTION=balanced

# Optional deployment budget (leave empty for none)
AUTOMIND_MAX_PARAMS=
AUTOMIND_MAX_COST=

# Where reports, figures and CSV/JSON are written
AUTOMIND_OUTDIR=outputs
